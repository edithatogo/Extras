{
    "version": "1.25.0",
    "description": "Kubernates container management tool that can build, push, and pull images and run containers.",
    "homepage": "https://rancherdesktop.io/",
    "license": "Apache-2.0",
    "notes": [
        "Rancher Desktop requires WSL (Windows Subsystem for Linux) to work properly.",
        "Learn more about WSL: https://aka.ms/wsl2"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/rancher-sandbox/rancher-desktop/releases/download/v1.25.0/Rancher.Desktop.Setup.1.25.0.msi",
            "hash": "sha512:4d75ded96424bcf0429fa310cbf61fb057fbd7860f6376eecbc20ed2623372a393f5fb242efd6767ccb4b0091b096ee77e62c07097011864cc4be30014275ff0"
        }
    },
    "extract_dir": "Rancher Desktop",
    "env_add_path": [
        "resources\\resources\\win32\\bin",
        "resources\\resources\\linux\\bin"
    ],
    "shortcuts": [
        [
            "Rancher Desktop.exe",
            "Rancher Desktop"
        ]
    ],
    "checkver": {
        "github": "https://github.com/rancher-sandbox/rancher-desktop"
    },
    "autoupdate": {
