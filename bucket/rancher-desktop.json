            "64bit": {
                "url": "https://github.com/rancher-sandbox/rancher-desktop/releases/download/v$version/Rancher.Desktop.Setup.$version.msi",
                "hash": {
                    "url": "$url.sha512sum"
                }
            }
        }
    }
}
